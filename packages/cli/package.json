{
    "name":  "@liveviewer/cli",
    "version":  "2.1.2",
    "description":  "Liveviewer CLI — design QA for live websites",
    "license":  "MIT",
    "bin":  {
                "liveviewer":  "bin/liveviewer.js"
            },
    "files":  [
                  "bin/"
              ],
    "scripts":  {
                    "test":  "node bin/liveviewer.js --version",
                    "audit":  "node bin/liveviewer.js audit",
                    "record":  "node bin/liveviewer.js record",
                    "screenshot":  "node bin/liveviewer.js screenshot",
                    "analyze":  "node bin/liveviewer.js analyze",
                    "extract":  "node bin/liveviewer.js extract",
                    "recommend":  "node bin/liveviewer.js recommend",
                    "mcp":  "node bin/liveviewer.js mcp"
                },
    "dependencies":  {
                         "@liveviewer/core":  "*",
                         "@liveviewer/llm":  "*",
                         "playwright":  "^1.52.0",
                         "sharp":  "^0.34.0",
                         "ffmpeg-static":  "^5.3.0",
                         "pixelmatch":  "^7.0.0"
                     }
}
