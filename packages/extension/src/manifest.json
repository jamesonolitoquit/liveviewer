{
  "manifest_version": 3,
  "name": "Liveviewer - WCAG Contrast Auditor",
  "short_name": "Liveviewer",
  "version": "1.0.0",
  "description": "Audit any page for WCAG color contrast failures directly in your browser",
  "icons": {
    "16": "src/icons/16.png",
    "48": "src/icons/48.png",
    "128": "src/icons/128.png"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "action": {
    "default_popup": "src/popup/index.html",
    "default_title": "Liveviewer - Run WCAG Audit"
  },
  "background": {
    "service_worker": "src/background/index.ts",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content/index.ts"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["src/popup/*"],
      "matches": ["<all_urls>"]
    }
  ]
}
