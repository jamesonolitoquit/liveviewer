{
  "name": "liveviewer-monorepo",
  "version": "4.0.0",
  "private": true,
  "description": "Frame-by-frame visual recording and analysis engine for live websites",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm -w packages/llm run build && npm -w apps/web run build",
    "start": "npm -w apps/web run start",
    "build:web": "npm -w apps/web run build",
    "test": "npm -w packages/core run test && npm -w packages/llm run test && npm -w packages/cli run test && npm -w apps/web run test",
    "test:core": "npm -w packages/core run test",
    "test:llm": "npm -w packages/llm run test",
    "test:cli": "npm -w packages/cli run test",
    "test:web": "npm -w apps/web run test",
    "test:performance": "node scripts/resilience-performance.js && node scripts/smoke-performance.js",
    "test:viewport-merge": "node scripts/benchmark-viewport-merge.js",
    "lint": "tsc --noEmit",
    "liveviewer": "node --import tsx/esm packages/cli/bin/liveviewer.js",
    "record": "node --import tsx/esm packages/cli/bin/liveviewer.js record",
    "screenshot": "node --import tsx/esm packages/cli/bin/liveviewer.js screenshot",
    "analyze": "node --import tsx/esm packages/cli/bin/liveviewer.js analyze",
    "mcp": "node --import tsx/esm packages/cli/bin/liveviewer.js mcp",
    "web": "npm -w apps/web run dev",
    "web:build": "npm -w apps/web run build",
    "postinstall": "node scripts/patch-lighthouse.js && patch-package && npx playwright install chromium 2>/dev/null || true",
    "verify:deployment": "node scripts/verify-deployment.js"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@crxjs/vite-plugin": "^2.4.0",
    "@types/papaparse": "^5.5.2",
    "@vitejs/plugin-react": "^6.0.2",
    "patch-package": "^8.0.1",
    "tsx": "^4.22.4",
    "vitest": "^4.1.8",
    "webextension-polyfill": "^0.12.0"
  },
  "dependencies": {
    "@react-pdf/renderer": "^4.5.1",
    "@sparticuz/chromium": "^149.0.0",
    "@upstash/ratelimit": "^2.0.5",
    "@upstash/redis": "^1.38.0",
    "date-fns": "^4.4.0",
    "geist": "^1.7.2",
    "papaparse": "^5.5.3",
    "playwright-core": "^1.60.0",
    "recharts": "^3.8.1"
  }
}
